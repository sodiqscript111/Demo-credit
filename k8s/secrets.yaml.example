# Copy this file to `secrets.yaml`, replace the values, then apply it.
# Do NOT commit real secrets.
apiVersion: v1
kind: Secret
metadata:
  name: demo-credit-secrets
  namespace: demo-credit
  labels:
    app.kubernetes.io/name: demo-credit
type: Opaque
stringData:
  DB_USER: "root"
  DB_PASSWORD: "change_me_mysql_root_password"
  JWT_SECRET: "change_me_to_a_long_random_secret"
  ADJUTOR_API_KEY: "change_me_adjutor_api_key"
