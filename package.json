{
  "name": "democredit",
  "version": "1.0.0",
  "description": "Wallet service backend (Node.js/TS/Express/Knex/MySQL)",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:docker": "ts-node --transpile-only src/server.ts",
    "migrate:make": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:make",
    "migrate:latest": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:status",
    "seed:make": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:make",
    "seed:run": "ts-node ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "mysql2": "^3.23.0",
    "pino": "^9.3.2",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.15.34",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
    "sqlite3": "^6.0.1",
    "strip-comments": "^2.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
